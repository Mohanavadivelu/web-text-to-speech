            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Pitch",
            "type": "array"
          },
          "speed": {
            "default": [
              0.5,
              2.0
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Speed",
            "type": "array"
          }
        },
        "required": [
          "languages"
        ],
        "title": "VoicesResponse",
        "type": "object"
      }
    }
