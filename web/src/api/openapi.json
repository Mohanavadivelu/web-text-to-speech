            "title": "Id",
            "type": "string"
          },
          "progress": {
            "default": 0,
            "title": "Progress",
            "type": "integer"
          },
          "queue_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Position"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "error",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "stream_url": {
            "title": "Stream Url",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signed MP3 link, valid for an hour (when done)",
            "title": "Url"
          },
          "wav_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Signed WAV link (signed-in users)",
            "title": "Wav Url"
          }
        },
        "required": [
          "id",
          "status",
          "stream_url"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "LanguageOut": {
        "properties": {
