    "/v1/tts/jobs": {
      "post": {
        "description": "Queue text for speech. Follow it live on `stream_url`, or poll the job.\n\nAnonymous visitors must include a Cloudflare Turnstile token. Signed-in users'\nsaved pronunciations are applied unless the request brings its own.",
        "operationId": "create_job_v1_tts_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
