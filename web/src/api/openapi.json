            "type": "string"
          },
          "word": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Word",
            "type": "string"
          }
        },
        "required": [
          "word",
          "say"
        ],
        "title": "Pronunciation",
        "type": "object"
      },
      "PronunciationsBody": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Pronunciation"
            },
            "maxItems": 200,
            "title": "Entries",
            "type": "array"
          }
        },
        "required": [
          "entries"
        ],
        "title": "PronunciationsBody",
        "type": "object"
      },
      "TextIn": {
        "properties": {
          "text": {
            "maxLength": 2000000,
