        "type": "object"
      },
      "HistoryOut": {
        "properties": {
          "days": {
            "title": "Days",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "days"
        ],
        "title": "HistoryOut",
        "type": "object"
      },
      "JobCreate": {
        "properties": {
          "blend_ratio": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Blend Ratio",
            "type": "number"
          },
          "blend_voice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blend Voice"
          },
          "lang": {
            "default": "a",
            "description": "Language code, see /v1/voices",
            "title": "Lang",
            "type": "string"
          },
          "pitch": {
            "default": 0.0,
            "maximum": 6.0,
            "minimum": -6.0,
            "title": "Pitch",
            "type": "number"
          },
          "pronunciations": {
            "items": {
              "$ref": "#/components/schemas/Pronunciation"
            },
            "maxItems": 200,
            "title": "Pronunciations",
            "type": "array"
          },
          "speed": {
            "default": 1.0,
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Speed",
            "type": "number"
          },
          "text": {
            "description": "Text to speak (limit depends on the account)",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "turnstile_token": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for anonymous visitors",
            "title": "Turnstile Token"
          },
          "voice": {
            "default": "af_heart",
            "title": "Voice",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "JobCreate",
        "type": "object"
      },
      "JobOut": {
        "properties": {
          "audio_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Seconds"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
