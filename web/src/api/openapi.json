            "title": "Code",
            "type": "string"
          },
          "default_voice": {
            "title": "Default Voice",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "preview_text": {
            "title": "Preview Text",
            "type": "string"
          },
          "voices": {
            "items": {
