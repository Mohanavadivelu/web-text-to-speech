        ],
        "title": "TextIn",
        "type": "object"
      },
      "TextOut": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TextOut",
        "type": "object"
      },
      "VoiceOut": {
        "properties": {
          "gender": {
            "enum": [
              "female",
              "male"
            ],
            "title": "Gender",
            "type": "string"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
