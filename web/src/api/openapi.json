          "uploads": {
            "title": "Uploads",
            "type": "boolean"
          },
          "wav": {
            "title": "Wav",
            "type": "boolean"
          }
        },
        "required": [
          "max_chars",
          "daily_chars",
          "max_active_jobs",
          "uploads",
          "wav"
        ],
        "title": "LimitsOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "chars_today": {
            "title": "Chars Today",
            "type": "integer"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsOut"
          },
          "signed_in": {
            "title": "Signed In",
            "type": "boolean"
          }
        },
        "required": [
          "signed_in",
          "email",
          "limits",
          "chars_today"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "Pronunciation": {
        "properties": {
          "say": {
            "maxLength": 200,
            "minLength": 1,
