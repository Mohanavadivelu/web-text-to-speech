# Copy to .env and fill in. Never commit .env.
# Values marked (M0.5) come from the accounts created in milestone M0.5.

# ── General ─────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
PUBLIC_WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# ── Redis (queue, rate limits, pub/sub) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase: Postgres + Auth (M0.5) ────────────────────────────────────────
# Project settings → API keys. The publishable key is safe in the browser;
# the secret key is server-only and bypasses row-level security.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# The API verifies user tokens against Supabase's public signing keys (JWKS):
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Project settings → Database → Connection string. Keep the password only in .env.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── Cloudflare R2: audio storage (M0.5) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kokoro-tts-audio
R2_SIGNED_URL_TTL_SECONDS=3600

# ── Cloudflare Turnstile: bot protection (M0.5) ─────────────────────────────
TURNSTILE_SITE_KEY=1x00000000000000000000AA       # Cloudflare's always-pass test key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Anonymous user cookie ───────────────────────────────────────────────────
ANON_COOKIE_SECRET=change-me-to-a-long-random-string

# ── Sentry (M0.5) ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Speech engine ───────────────────────────────────────────────────────────
MODELS_DIR=./models
ENGINE_THREADS=0                    # ONNX Runtime intra-op threads; 0 = runtime default
FIRST_SEGMENT_CHARS=150             # short first segment so streaming starts quickly
