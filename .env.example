# Copy to .env and fill in. Never commit .env.
# Values marked (M0.5) come from the accounts created in milestone M0.5.

# ── General ─────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
PUBLIC_WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# ── Redis (queue, rate limits, pub/sub) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Supabase: Postgres + Auth (M0.5) ────────────────────────────────────────
# Project settings → API keys. The publishable key is safe in the browser;
# the secret key is server-only and bypasses row-level security.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# The API verifies user tokens against Supabase's public signing keys (JWKS):
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Set SUPABASE_JWT_ISSUER only if tokens name a different address than SUPABASE_URL
# (local development: the browser uses 127.0.0.1, containers host.docker.internal).
SUPABASE_JWT_ISSUER=
# Project settings → Database → Connection string. Keep the password only in .env.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ── Cloudflare R2: audio storage (M0.5) ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kokoro-tts-audio
R2_SIGNED_URL_TTL_SECONDS=3600

# ── Cloudflare Turnstile: bot protection (required in production) ───────────
TURNSTILE_SITE_KEY=1x00000000000000000000AA       # Cloudflare's always-pass test key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Visitors ────────────────────────────────────────────────────────────────
# Signs the anon_id cookie. Required in production (the API refuses to start
# with the development default). Make one with: python -c "import secrets; print(secrets.token_hex(32))"
ANON_COOKIE_SECRET=change-me-to-a-long-random-string
TRUST_CLOUDFLARE_IP_HEADER=false    # true only when the API sits behind Cloudflare

# ── Limits (anonymous visitors) ─────────────────────────────────────────────
ANON_MAX_CHARS=2000
ANON_DAILY_CHARS=10000
MAX_ACTIVE_JOBS=2                   # queued + running, per visitor
RATE_LIMIT_PER_MINUTE=10            # job and upload requests, per IP

# ── Limits (signed-in users) ────────────────────────────────────────────────
USER_MAX_CHARS=20000
USER_DAILY_CHARS=100000
USER_MAX_ACTIVE_JOBS=3
USER_RATE_LIMIT_PER_MINUTE=30       # per account
HISTORY_DAYS=7
MAX_QUEUED_JOBS=30                  # per queue; above this new jobs get "busy"

# ── Sentry (M0.5) ───────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Speech engine and workers ───────────────────────────────────────────────
MODELS_DIR=./models
ENGINE_THREADS=0                    # ONNX Runtime intra-op threads; 0 = runtime default
ENGINE_SPIN=1                       # 0 when several workers share one machine
FIRST_SEGMENT_CHARS=150             # short first segment so streaming starts quickly
WORKER_QUEUE=tts:long               # tts:short or tts:long
SHORT_JOB_CHARS=1000                # texts up to this length go to the short queue

# ── Development storage (docker compose sets these; see server/docker-compose.yml)
# R2_ENDPOINT_URL=http://seaweedfs:8333
# R2_PUBLIC_ENDPOINT_URL=http://localhost:8333
